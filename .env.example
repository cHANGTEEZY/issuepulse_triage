PORT=3000
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0

CORS_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Local libSQL file, or a remote Turso URL (libsql://<db>-<org>.turso.io)
TURSO_DATABASE_URL=file:local.db
# Required for remote Turso databases. Leave unset for file: URLs.
# TURSO_AUTH_TOKEN=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Get your key from https://app.arcjet.com or run: npx @arcjet/cli auth login
ARCJET_KEY=ajkey_your_key_here
ARCJET_ENV=development

# GitHub OAuth app used by Better Auth (user sign-in). Callback:
# http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub App used for installation tokens, webhooks, and issue sync.
# These stay on the API. Do not expose them to the frontend.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents. A single line with literal \n is fine.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
