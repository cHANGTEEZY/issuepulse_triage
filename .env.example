PORT=3000
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0

CORS_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Local libSQL file, or a remote Turso URL (libsql://<db>-<org>.turso.io)
TURSO_DATABASE_URL=file:local.db
# Required for remote Turso databases. Leave unset for file: URLs.
# TURSO_AUTH_TOKEN=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Get your key from https://app.arcjet.com or run: npx @arcjet/cli auth login
ARCJET_KEY=ajkey_your_key_here
ARCJET_ENV=development
